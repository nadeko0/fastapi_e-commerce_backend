# Copy this file to .env and fill in real values for your environment.
# No secrets below are real - they are placeholders only.
#
# With ENVIRONMENT set to anything but development or test, the app refuses
# to start while a secret is a placeholder (contains change-me, changeme or
# placeholder) or too short: JWT_SECRET_KEY at least as many bytes as its
# hash (32 for HS256, 48 for HS384, 64 for HS512), STRIPE_WEBHOOK_SECRET 32,
# POSTGRES_PASSWORD and REDIS_PASSWORD 16 (REDIS_PASSWORD must be set).
# SMTP_PASSWORD only must not be a placeholder.

# --- Application ---
PROJECT_NAME=E-commerce Backend
ENVIRONMENT=development
DEBUG=False
HOST=0.0.0.0
# Port uvicorn binds to. Inside Docker this must stay 8000 - it's what the
# Dockerfile's HEALTHCHECK and docker-compose.yml's container-side port
# mapping both hardcode. To publish the container on a different host
# port (e.g. to avoid a conflict with another service), set
# DOCKER_API_PORT below instead of changing this value.
PORT=8000
WORKERS=4
# Load shedding, per worker: answer 503 instead of accepting more requests
# than the worker can serve. Without it, overload queues up until requests
# time out; with it, the excess is refused in a millisecond and everything
# admitted is served at normal speed. Keep it at or below the sync pool
# (DB_POOL_SIZE + DB_MAX_OVERFLOW). Remove the line for no limit.
MAX_IN_FLIGHT_REQUESTS=15

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- JWT ---
# Generate a real secret, e.g.: openssl rand -hex 32 (64 characters, long
# enough for every HS algorithm).
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_SERVER=localhost
# The superuser and schema owner: what the migrations run as. Under Docker
# Compose the api and Celery services do not use it: they connect as
# APP_DB_USER below, which can only read and write rows.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecommerce
# docker-compose.yml only: the application's own role, created on the
# database's first start by docker/postgres/initdb/10-app-role.sh and
# passed to the api and Celery services as their POSTGRES_USER/PASSWORD.
# Must differ from POSTGRES_USER. Migrations under Compose:
#   docker compose --profile migrate run --rm migrate
APP_DB_USER=ecommerce_app
APP_DB_PASSWORD=change-me
# Published on 127.0.0.1 only (docker-compose.yml), like DOCKER_REDIS_PORT.
DOCKER_POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
DOCKER_REDIS_PORT=6379
# docker-compose.yml only: Redis's memory cap. When it is reached Redis refuses
# writes rather than evicting anything (see the redis service there).
REDIS_MAXMEMORY=256mb

# --- Cart ---
# Days a cart lives after its last write: an account's cart, and the cart of
# a visitor who is not logged in. The guest value is also the lifetime of the
# cookie that carries the guest cart's identifier.
REDIS_CART_TTL_DAYS=30
REDIS_GUEST_CART_TTL_DAYS=7
# Most distinct lines (product, or product + variant) one cart can hold.
CART_MAX_LINES=100
# The guest cart cookie is HttpOnly, SameSite=Lax and Secure. Set this to
# false only to develop over plain http; never in a deployed environment.
GUEST_CART_COOKIE_SECURE=true

# --- Rate limiting ---
# Reverse proxies / load balancers allowed to set X-Forwarded-For, comma-
# separated: single addresses and networks in CIDR form, e.g.
#   TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12,fd00::/8
# Behind a proxy this MUST name it, or every visitor is seen as the proxy
# and shares one set of counters. Leave empty when clients connect directly:
# the header is then ignored (a client could otherwise pick its identity).
# The client is the rightmost X-Forwarded-For entry that is not a trusted
# proxy, so the proxy must append the peer address (nginx:
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for).
TRUSTED_PROXIES=
# Kill switch: false turns off every limit below, the failed-login counter included.
RATE_LIMIT_ENABLED=true
# Limits are "N/period" (second, minute, hour, day, or a multiple: "10/15 minutes"),
# counted per operation (method + route template) and per caller; over the
# limit the answer is 429 with Retry-After. All of it: app/core/rate_limit.py.
# Any route not covered below: per logged-in user, otherwise per client address.
RATE_LIMIT_DEFAULT=300/minute
# Product search: per logged-in user, otherwise per client address.
RATE_LIMIT_SEARCH=60/minute
# Register, login, password reset, token submit, verification resend: per client address.
RATE_LIMIT_AUTH=20/minute
# Order creation, payment, checkout session: per user.
RATE_LIMIT_CHECKOUT=10/minute
# Failed logins per email, from any address; then 429 for that email until the period ends.
RATE_LIMIT_LOGIN_FAILURES=10/15 minutes
# New guest carts per client address (adding to an existing one is not counted).
RATE_LIMIT_GUEST_CART=100/hour

# --- GDPR / data protection ---
USER_DATA_RETENTION_DAYS=365
GDPR_EXPORT_EXPIRY_HOURS=24
DATA_DELETION_GRACE_PERIOD_DAYS=1

COMPANY_NAME=Your Company Name
COMPANY_EMAIL=contact@yourcompany.com
COMPANY_ADDRESS=Your Company Address, EU
COMPANY_VAT=EU VAT Number
DPO_NAME=Data Protection Officer
DPO_EMAIL=dpo@yourcompany.com
TECHNICAL_CONTACT=Technical Support
ADMIN_EMAIL=admin@yourcompany.com

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
EMAILS_FROM_EMAIL=noreply@yourcompany.com
EMAILS_FROM_NAME=Your Company Name

# --- Payments ---
# mock: the in-process mock provider, which never moves money and makes no
# network call. stripe: the real Stripe API with STRIPE_SECRET_KEY.
# ENVIRONMENT=production refuses to start with mock or with the
# placeholder secrets below.
PAYMENT_PROVIDER=mock
# Placeholders for the mock. Do not put real Stripe keys in this file; set
# them in the deployment's own environment.
STRIPE_SECRET_KEY=sk_test_mock_placeholder
STRIPE_WEBHOOK_SECRET=whsec_mock_placeholder
# Currency every order is priced and charged in (ISO 4217, upper case).
# Each order keeps the value it was placed with; payment requests cannot
# choose another. Currencies without a minor unit (JPY, KRW) are not
# supported yet.
STORE_CURRENCY=USD
# The storefront's origin (scheme, host, port). Stripe's hosted checkout
# page sends the customer back here; redirect URLs a client sends are only
# accepted on this origin. Must be https:// in production.
FRONTEND_URL=http://localhost:3000

# --- Docker Compose ---
DOCKER_NETWORK_NAME=ecommerce
# Host port the api container is published on. Separate from PORT (which
# must stay 8000, see above) - change this one if 8000 is already taken
# on the host.
DOCKER_API_PORT=8000
